# Capacitor regenerates the whole native project on every build
/android/
/ios/
node_modules/

# Local SDK paths — machine specific, must never be committed
local.properties

# Signing material. Losing this keystore means you can never update the
# app again; leaking it means someone else can sign as you.
*.keystore
*.jks
keystore.b64

# Editor / OS noise
*.bak
.DS_Store

